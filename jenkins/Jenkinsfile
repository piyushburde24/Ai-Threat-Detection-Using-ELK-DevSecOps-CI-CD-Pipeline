pipeline {

    agent any


    environment {

        IMAGE_NAME = "ai-threat-detection"
        IMAGE_TAG = "latest"
        DOCKER_NETWORK = "devsecops-net"

    }



    stages {


        stage('Checkout Source Code') {

            steps {

                checkout scm

            }

        }




        stage('Setup Python Environment') {

            steps {

                sh '''

                echo "Creating Python virtual environment"


                cd app


                python3 -m venv venv


                . venv/bin/activate


                pip install --upgrade pip


                pip install -r requirements.txt


                '''

            }

        }






        stage('Run Unit Tests') {

            steps {

                sh '''

                echo "Running Flask tests"


                cd app


                . venv/bin/activate


                pytest tests \
                --junitxml=test-results.xml \
                --verbose


                '''

            }

        }







        stage('SonarQube Analysis') {


            steps {


                withSonarQubeEnv('SonarQube') {


                    sh '''


                    echo "Running SonarQube Scan"



                    sonar-scanner \
                    -Dsonar.projectKey=ai-threat-detection \
                    -Dsonar.projectName=ai-threat-detection \
                    -Dsonar.sources=app \
                    -Dsonar.python.version=3.13



                    '''


                }


            }


        }







        stage('SonarQube Quality Gate') {


            steps {


                timeout(time:5, unit:'MINUTES') {


                    echo "Checking SonarQube Quality Gate"



                    waitForQualityGate abortPipeline:true



                }


            }


        }








        stage('Build Docker Image') {


            steps {


                sh '''


                echo "Building Docker image"



                docker build \
                -t ${IMAGE_NAME}:${IMAGE_TAG} \
                app



                '''


            }


        }








        stage('Trivy Security Scan') {


            steps {


                sh '''


                echo "Running Trivy security scan"



                mkdir -p trivy/reports



                trivy image \
                --severity HIGH,CRITICAL \
                --format table \
                --output trivy/reports/trivy-report.txt \
                ${IMAGE_NAME}:${IMAGE_TAG}



                echo "Trivy scan completed"



                '''


            }


        }








        stage('Create Docker Network') {


            steps {


                sh '''


                echo "Creating Docker network"



                docker network create ${DOCKER_NETWORK} || true



                '''


            }


        }









        stage('Deploy Flask Container') {


            steps {


                sh '''


                echo "Deploying Flask application"



                docker rm -f flask-app || true





                docker run -d \
                --name flask-app \
                --restart unless-stopped \
                --network ${DOCKER_NETWORK} \
                -p 5000:5000 \
                --health-cmd="curl -f http://localhost:5000/health || exit 1" \
                --health-interval=30s \
                --health-timeout=10s \
                --health-retries=3 \
                ${IMAGE_NAME}:${IMAGE_TAG}





                '''

            }


        }









        stage('Verify Application') {


            steps {


                sh '''


                echo "Checking application health"



                sleep 10




                if docker exec flask-app curl -f http://localhost:5000/health

                then


                    echo "Application is healthy and running"



                else



                    echo "Application failed health check"



                    docker logs flask-app



                    exit 1



                fi




                echo "Deployment verification completed"



                '''


            }


        }



    }









    post {



        always {



            echo "Collecting reports"




            junit allowEmptyResults:true,

            testResults:'app/test-results.xml'






            archiveArtifacts(

                artifacts:'trivy/reports/*',

                fingerprint:true,

                allowEmptyArchive:true

            )



        }







        success {



            echo "================================"



            echo "Pipeline completed successfully"



            echo "Flask application deployed on port 5000"



            echo "================================"



        }







        failure {



            echo "Pipeline failed. Check Jenkins logs."



        }



    }



}
