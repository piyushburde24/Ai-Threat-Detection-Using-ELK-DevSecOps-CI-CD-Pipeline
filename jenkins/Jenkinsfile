pipeline {

    agent any


    environment {

        IMAGE_NAME = "ai-threat-detection"
        IMAGE_TAG = "latest"
        DOCKER_NETWORK = "devsecops-net"
        CONTAINER_NAME = "flask-app"

    }



    stages {


        stage('Checkout Source Code') {

            steps {

                checkout scm

            }

        }




        stage('Setup Python Environment') {

            steps {

                sh '''

                echo "Creating Python virtual environment"


                cd app


                python3 -m venv venv


                . venv/bin/activate


                pip install --upgrade pip


                pip install -r requirements.txt


                '''

            }

        }





        stage('Run Unit Tests') {

            steps {

                sh '''

                echo "Running Flask tests"


                cd app


                . venv/bin/activate


                pytest tests \
                --junitxml=test-results.xml \
                --verbose


                '''

            }

        }






        stage('SonarQube Analysis') {


            steps {


                withSonarQubeEnv('SonarQube') {


                    sh '''


                    echo "Running SonarQube Scan"



                    sonar-scanner \
                    -Dsonar.projectKey=ai-threat-detection \
                    -Dsonar.projectName=ai-threat-detection \
                    -Dsonar.sources=app \
                    -Dsonar.python.version=3.13



                    '''


                }


            }


        }







        stage('SonarQube Quality Gate') {


            steps {


                timeout(time:5, unit:'MINUTES') {


                    echo "Checking SonarQube Quality Gate"



                    waitForQualityGate abortPipeline:true



                }


            }


        }








        stage('Build Docker Image') {


            steps {


                sh '''


                echo "Building Docker image"



                docker build \
                -t ${IMAGE_NAME}:${IMAGE_TAG} \
                app



                docker images | grep ${IMAGE_NAME}



                '''


            }


        }








        stage('Trivy Security Scan') {


            steps {


                sh '''


                echo "Running Trivy security scan"



                mkdir -p trivy/reports



                trivy image \
                --severity HIGH,CRITICAL \
                --format table \
                --output trivy/reports/trivy-report.txt \
                ${IMAGE_NAME}:${IMAGE_TAG}



                echo "Trivy scan completed"



                '''


            }


        }








        stage('Create Docker Network') {


            steps {


                sh '''


                echo "Creating Docker network"



                docker network create ${DOCKER_NETWORK} || true



                '''


            }


        }









        stage('Deploy Flask Container') {


            steps {


                sh '''


                echo "Deploying Flask application"



                docker rm -f ${CONTAINER_NAME} || true



                docker run -d \
                --name ${CONTAINER_NAME} \
                --restart unless-stopped \
                --network ${DOCKER_NETWORK} \
                -p 5000:5000 \
                ${IMAGE_NAME}:${IMAGE_TAG}



                echo "Container started"



                sleep 5



                docker ps | grep ${CONTAINER_NAME}



                '''


            }


        }









        stage('Verify Application') {


            steps {


                sh '''


                echo "Checking Flask application health"



                for i in {1..12}

                do



                    STATUS=$(curl -s \
                    -o /dev/null \
                    -w "%{http_code}" \
                    http://localhost:5000/health || true)



                    if [ "$STATUS" = "200" ]

                    then


                        echo "================================"



                        echo "Application is healthy"



                        echo "HTTP STATUS: $STATUS"



                        echo "================================"



                        exit 0



                    fi




                    echo "Waiting for application startup..."



                    sleep 5



                done





                echo "Application failed health check"



                echo "Docker container status:"



                docker ps -a | grep ${CONTAINER_NAME}



                echo "Docker logs:"



                docker logs ${CONTAINER_NAME}



                exit 1



                '''


            }


        }



    }









    post {



        always {



            echo "Collecting reports"




            junit(

                allowEmptyResults:true,

                testResults:'app/test-results.xml'

            )







            archiveArtifacts(

                artifacts:'trivy/reports/*',

                fingerprint:true,

                allowEmptyArchive:true

            )



        }







        success {



            echo "================================"



            echo "PIPELINE COMPLETED SUCCESSFULLY"



            echo "FLASK APPLICATION RUNNING ON PORT 5000"



            echo "================================"



        }







        failure {



            echo "================================"



            echo "PIPELINE FAILED"



            echo "CHECK JENKINS CONSOLE LOGS"



            echo "================================"



        }



    }



}
